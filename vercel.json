{
  "trailingSlash": false,
  "functions": {
    "api/[...route].ts": {
      "includeFiles": "{index.html,dist/index.html,api/_seoCatalog.json,src/data/newsArchive.json,firebase-applet-config.json,public/robots.txt,public/sitemap.xml}"
    }
  },
  "redirects": [
    {
      "source": "/contacto",
      "destination": "/contato",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "/contato",
      "statusCode": 301
    },
    {
      "source": "/sitemap",
      "destination": "/mapa-do-site",
      "statusCode": 301
    },
    {
      "source": "/meu-perfil",
      "destination": "/perfil",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/inicio",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/livro",
      "destination": "/livros",
      "statusCode": 301
    },
    {
      "source": "/livro/:id",
      "destination": "/livros/:id",
      "statusCode": 301
    },
    {
      "source": "/noticia",
      "destination": "/noticias",
      "statusCode": 301
    },
    {
      "source": "/noticia/:slug",
      "destination": "/noticias/:slug",
      "statusCode": 301
    },
    {
      "source": "/news",
      "destination": "/noticias",
      "statusCode": 301
    },
    {
      "source": "/news/:slug",
      "destination": "/noticias/:slug",
      "statusCode": 301
    },
    {
      "source": "/anime",
      "destination": "/animes",
      "statusCode": 301
    },
    {
      "source": "/anime/:id",
      "destination": "/animes/:id",
      "statusCode": 301
    },
    {
      "source": "/manga",
      "destination": "/animes",
      "statusCode": 301
    },
    {
      "source": "/mangas",
      "destination": "/animes",
      "statusCode": 301
    },
    {
      "source": "/filme",
      "destination": "/cinema",
      "statusCode": 301
    },
    {
      "source": "/filmes",
      "destination": "/cinema",
      "statusCode": 301
    },
    {
      "source": "/filme/:id",
      "destination": "/cinema/:id",
      "statusCode": 301
    },
    {
      "source": "/filmes/:id",
      "destination": "/cinema/:id",
      "statusCode": 301
    },
    {
      "source": "/serie",
      "destination": "/cinema",
      "statusCode": 301
    },
    {
      "source": "/series",
      "destination": "/cinema",
      "statusCode": 301
    },
    {
      "source": "/serie/:id",
      "destination": "/cinema/:id",
      "statusCode": 301
    },
    {
      "source": "/series/:id",
      "destination": "/cinema/:id",
      "statusCode": 301
    },
    {
      "source": "/dorama",
      "destination": "/cinema",
      "statusCode": 301
    },
    {
      "source": "/doramas",
      "destination": "/cinema",
      "statusCode": 301
    },
    {
      "source": "/webtoon",
      "destination": "/webtoons",
      "statusCode": 301
    },
    {
      "source": "/webtoons/:id",
      "destination": "/webtoon/:id",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/[...route]?route=sitemap.xml"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/api/[...route]?route=sitemap-index.xml"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/[...route]?route=news-sitemap.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/[...route]?route=rss.xml"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/[...route]?route=rss.xml"
    },
    {
      "source": "/sitemap-(pages|books|cinema|animes|webtoons|news).xml",
      "destination": "/api/[...route]?route=sitemap-$1.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...route]?route=$1"
    },
    {
      "source": "/((?!api/|_vercel/|\\.well-known/|assets/|chapters/|pdf/|sitemap.*\\.xml|news-sitemap\\.xml|rss\\.xml|feed\\.xml|robots\\.txt|llms.*\\.txt|.*\\..*).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Google-InspectionTool|AdsBot-Google|Mediapartners-Google|Storebot-Google|GoogleOther|Bingbot|bingbot|BingPreview|bingpreview|msnbot|AdIdxBot|adidxbot|Slurp|slurp|DuckDuckBot|duckduckbot|Applebot|applebot|OAI-SearchBot|oai-searchbot|ChatGPT-User|chatgpt-user|GPTBot|gptbot|ClaudeBot|claudebot|PerplexityBot|perplexitybot|Yandex|yandex|facebookexternalhit|Twitterbot|twitterbot|LinkedInBot|linkedinbot|WhatsApp|whatsapp|Slackbot|slackbot|TelegramBot|telegrambot|Discordbot|discordbot).*"
        }
      ],
      "destination": "/api/[...route]?route=seo-prerender&path=/$1"
    },
    {
      "source": "/((?!api/|_vercel/|\\.well-known/|assets/|chapters/|pdf/|sitemap.*\\.xml|news-sitemap\\.xml|rss\\.xml|feed\\.xml|robots\\.txt|llms.*\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(sitemap.*\\.xml|news-sitemap\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/(rss\\.xml|feed\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, s-maxage=1800"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(admin|auth|perfil|meu-perfil|biblioteca|buscar|para-voce|continuar-lendo|redefinir-senha|compra/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(ler|leitura)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/((?!api/|_vercel/|\\.well-known/).*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
