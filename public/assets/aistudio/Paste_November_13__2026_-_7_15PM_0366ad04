<script>
  const SECTION_META = {
    history:   { title: "Histórico",   filters: ["Todos", "Livros", "Filmes & Séries", "Animes", "Mangás", "Webtoons"] },
    downloads: { title: "Downloads",   filters: ["Todos", "Em Andamento", "Concluídos", "Offline", "Com Falha"] },
    reading:   { title: "Leituras",    filters: ["Todos", "Livros", "Mangás", "Webtoons"] },
    cinema:    { title: "Cinema",      filters: ["Todos", "Filmes & Séries", "Animes"] },
    shelf:     { title: "Estante",     filters: ["Todos", "Livros", "Filmes & Séries", "Mangás"] },
    reviews:   { title: "Avaliações",  filters: ["Todos", "Livros", "Filmes & Séries"] }
  };

  let state = {
    activeTab: "history",
    activeFilter: "Todos",
    interests: [],
    audio_language: "pt-BR",
    reader_theme: "sepia"
  };

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = str || "";
    return div.innerHTML;
  }

  function showToast(msg) {
    const el = document.getElementById("toast");
    el.textContent = msg;
    el.classList.add("visible");
    clearTimeout(window.__toastTimer);
    window.__toastTimer = setTimeout(() => el.classList.remove("visible"), 2400);
  }

  async function fetchHub() {
    const res = await fetch("/api/hub");
    const data = await res.json();
    applyHubData(data);
    await loadItems();
  }

  function applyHubData(data) {
    const p = data.profile;
    const m = data.metrics;

    // Cabeçalho
    const avatarEl = document.getElementById("heroAvatar");
    if (p.avatar_url) {
      avatarEl.innerHTML = `<img src="${escapeHtml(p.avatar_url)}" alt="Avatar" onerror="this.parentElement.textContent='${escapeHtml(p.initials)}'">`;
    } else {
      avatarEl.textContent = p.initials;
    }

    document.getElementById("heroEyebrow").textContent = `${p.role_badge} · ${p.email}`;
    document.getElementById("heroName").textContent = p.display_name;
    document.getElementById("heroBio").textContent = p.bio;

    const tagsEl = document.getElementById("heroTags");
    tagsEl.innerHTML = p.interests.map(t => `<span class="tag-chip">${escapeHtml(t)}</span>`).join("");

    // Métricas e contadores das abas
    document.getElementById("mHistory").textContent = m.history;
    document.getElementById("mDownloads").textContent = m.downloads;
    document.getElementById("mReading").textContent = m.reading;
    document.getElementById("mCinema").textContent = m.cinema;
    document.getElementById("mShelf").textContent = m.shelf;

    document.getElementById("cHistory").textContent = m.history;
    document.getElementById("cDownloads").textContent = m.downloads;
    document.getElementById("cReading").textContent = m.reading;
    document.getElementById("cCinema").textContent = m.cinema;
    document.getElementById("cShelf").textContent = m.shelf;
    document.getElementById("cReviews").textContent = m.reviews;

    // Formulário de Preferências
    document.getElementById("inName").value = p.display_name;
    document.getElementById("inAvatar").value = p.avatar_url;
    document.getElementById("inBio").value = p.bio;
    state.interests = [...p.interests];
    renderEditableTags();
    selectAudio(p.audio_language);
    selectTheme(p.reader_theme);
  }

  function switchTab(tab) {
    state.activeTab = tab;
    state.activeFilter = "Todos";
    document.getElementById("searchInput").value = "";

    document.querySelectorAll(".seg-tab").forEach(btn => {
      btn.classList.toggle("active", btn.dataset.tab === tab);
    });

    const isPref = tab === "preferences";
    document.getElementById("collectionView").classList.toggle("hidden", isPref);
    document.getElementById("preferencesView").classList.toggle("hidden", !isPref);

    if (!isPref) {
      document.getElementById("sectionTitle").textContent = SECTION_META[tab].title;
      renderSubFilters();
      loadItems();
    }
  }

  function renderSubFilters() {
    const bar = document.getElementById("subFilterBar");
    const filters = SECTION_META[state.activeTab].filters;
    bar.innerHTML = filters.map(f => `
      <button class="filter-pill ${f === state.activeFilter ? 'active' : ''}"
              onclick="setSubFilter('${f}')">${escapeHtml(f)}</button>
    `).join("");
  }

  function setSubFilter(f) {
    state.activeFilter = f;
    renderSubFilters();
    loadItems();
  }

  async function loadItems() {
    if (state.activeTab === "preferences") return;
    const q = document.getElementById("searchInput").value;
    const params = new URLSearchParams({
      section: state.activeTab,
      subfilter: state.activeFilter,
      q: q
    });

    const res = await fetch(`/api/items?${params.toString()}`);
    const data = await res.json();
    const container = document.getElementById("itemsContainer");

    if (!data.items.length) {
      container.innerHTML = `
        <div class="empty-state">
          <div class="empty-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="9"></circle>
              <polyline points="12 7 12 12 15 14"></polyline>
            </svg>
          </div>
          <div class="empty-title">Nenhum registo encontrado</div>
          <div class="empty-sub">Os itens aparecerão automaticamente aqui conforme o seu uso.</div>
        </div>
      `;
      return;
    }

    container.innerHTML = data.items.map(item => `
      <div class="item-row">
        <div class="item-main">
          <span class="item-title">${escapeHtml(item.title)}</span>
          <span class="item-subtitle">${escapeHtml(item.subtitle)}</span>
        </div>
        <div class="item-meta">
          <span class="badge-neutral">${escapeHtml(item.category)}</span>
          <span class="item-subtitle" style="font-size:12px">${escapeHtml(item.meta)}</span>
        </div>
      </div>
    `).join("");
  }

  // Tags Interativas
  function renderEditableTags() {
    const editor = document.getElementById("tagsEditor");
    const input = document.getElementById("tagInput");
    editor.querySelectorAll(".editable-chip").forEach(el => el.remove());

    state.interests.forEach((tag, idx) => {
      const chip = document.createElement("span");
      chip.className = "editable-chip";
      chip.innerHTML = `${escapeHtml(tag)} <button type="button" onclick="removeTag(${idx})">&times;</button>`;
      editor.insertBefore(chip, input);
    });
  }

  function removeTag(idx) {
    state.interests.splice(idx, 1);
    renderEditableTags();
  }

  document.getElementById("tagInput").addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === ",") {
      e.preventDefault();
      const val = e.target.value.trim().replace(/,$/, "");
      if (val && !state.interests.includes(val) && state.interests.length < 12) {
        state.interests.push(val);
        e.target.value = "";
        renderEditableTags();
      }
    }
  });

  function selectAudio(val) {
    state.audio_language = val;
    document.querySelectorAll("#audioSelector .choice-card").forEach(btn => {
      btn.classList.toggle("selected", btn.dataset.value === val);
    });
  }

  function selectTheme(val) {
    state.reader_theme = val;
    document.querySelectorAll("#themeSelector .choice-card").forEach(btn => {
      btn.classList.toggle("selected", btn.dataset.value === val);
    });
  }

  async function savePreferences(e) {
    e.preventDefault();
    const payload = {
      display_name: document.getElementById("inName").value,
      avatar_url: document.getElementById("inAvatar").value,
      bio: document.getElementById("inBio").value,
      interests: state.interests,
      audio_language: state.audio_language,
      reader_theme: state.reader_theme
    };

    const res = await fetch("/api/profile", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    if (res.ok) {
      const updated = await res.json();
      applyHubData(updated);
      showToast("Alterações guardadas");
    } else {
      showToast("Verifique os campos preenchidos");
    }
  }

  async function toggleDemoData() {
    const res = await fetch("/api/demo/toggle", { method: "POST" });
    const data = await res.json();
    applyHubData(data);
    loadItems();
    showToast(data.seeded ? "Acervo de demonstração carregado" : "Acervo limpo (estado zero)");
  }

  document.querySelectorAll(".seg-tab").forEach(btn => {
    btn.addEventListener("click", () => switchTab(btn.dataset.tab));
  });

  renderSubFilters();
  fetchHub();
</script>
</body>
</html>
"""


