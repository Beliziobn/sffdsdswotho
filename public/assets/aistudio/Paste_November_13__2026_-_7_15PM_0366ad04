"""
Wotho — User Hub & Preferences (Super Integração Full-Stack)
Arquitetura: FastAPI + Pydantic + SQLite3 + Interface Minimalista Monocromática
"""

import json
import sqlite3
from contextlib import contextmanager
from pathlib import Path
from typing import List, Literal, Optional

import uvicorn
from fastapi import FastAPI, Query
from fastapi.responses import HTMLResponse
from pydantic import BaseModel, Field

DB_PATH = Path("wotho_profile.db")

app = FastAPI(title="Wotho Profile & Preferences Hub", version="2.0.0")


# =====================================================================
# 1. CAMADA DE DADOS & PERSISTÊNCIA (SQLite Nativo)
# =====================================================================

@contextmanager
def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    try:
        yield conn
        conn.commit()
    finally:
        conn.close()


def init_db():
    with get_db() as conn:
        conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS user_profile (
                id INTEGER PRIMARY KEY CHECK (id = 1),
                email TEXT NOT NULL,
                role_badge TEXT NOT NULL,
                display_name TEXT NOT NULL,
                avatar_url TEXT DEFAULT '',
                bio TEXT DEFAULT '',
                interests_json TEXT NOT NULL,
                audio_language TEXT NOT NULL,
                reader_theme TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS library_items (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                section TEXT NOT NULL,      -- history, downloads, reading, cinema, shelf, reviews
                category TEXT NOT NULL,     -- Livros, Filmes & Séries, Animes, Mangás, Webtoons
                status TEXT DEFAULT 'ok',   -- Em Andamento, Concluídos, Offline, Com Falha
                title TEXT NOT NULL,
                subtitle TEXT NOT NULL,
                meta TEXT NOT NULL
            );
            """
        )

        # Popula o perfil inicial exatamente com os dados da Wotho se ainda não existir
        exists = conn.execute("SELECT 1 FROM user_profile WHERE id = 1").fetchone()
        if not exists:
            conn.execute(
                """
                INSERT INTO user_profile (
                    id, email, role_badge, display_name, avatar_url, bio,
                    interests_json, audio_language, reader_theme
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    1,
                    "miguelworscoi@gmail.com",
                    "Editor-Chefe & Admin Mestre",
                    "Miguel Worscoi",
                    "",
                    "Editor-Chefe e curador literário, cinematográfico e cultural da Wotho.",
                    json.dumps(["Filosofia", "Ficção Científica", "Seinen", "Cinema"], ensure_ascii=False),
                    "pt-BR",
                    "sepia",
                ),
            )


# =====================================================================
# 2. SCHEMAS DE VALIDAÇÃO (Pydantic)
# =====================================================================

class ProfileUpdatePayload(BaseModel):
    display_name: str = Field(..., min_length=2, max_length=80)
    avatar_url: Optional[str] = Field(default="", max_length=500)
    bio: str = Field(default="", max_length=280)
    interests: List[str] = Field(default_factory=list, max_length=12)
    audio_language: Literal["pt-BR", "original"] = "pt-BR"
    reader_theme: Literal["light", "sepia", "graphite", "oled"] = "sepia"


# =====================================================================
# 3. ROTAS DE INTEGRAÇÃO DA API
# =====================================================================

def compute_initials(name: str) -> str:
    parts = [p for p in name.strip().split() if p]
    if not parts:
        return "W"
    if len(parts) == 1:
        return parts[0][:2].upper()
    return (parts[0][0] + parts[-1][0]).upper()


def serialize_hub_state(conn: sqlite3.Connection) -> dict:
    row = conn.execute("SELECT * FROM user_profile WHERE id = 1").fetchone()
    counts_raw = conn.execute(
        "SELECT section, COUNT(*) as total FROM library_items GROUP BY section"
    ).fetchall()
    counts_map = {r["section"]: r["total"] for r in counts_raw}

    total_history = sum(counts_map.values())

    return {
        "profile": {
            "email": row["email"],
            "role_badge": row["role_badge"],
            "display_name": row["display_name"],
            "initials": compute_initials(row["display_name"]),
            "avatar_url": row["avatar_url"] or "",
            "bio": row["bio"] or "",
            "interests": json.loads(row["interests_json"]),
            "audio_language": row["audio_language"],
            "reader_theme": row["reader_theme"],
        },
        "metrics": {
            "history": total_history,
            "downloads": counts_map.get("downloads", 0),
            "reading": counts_map.get("reading", 0),
            "cinema": counts_map.get("cinema", 0),
            "shelf": counts_map.get("shelf", 0) + counts_map.get("reviews", 0),
            "reviews": counts_map.get("reviews", 0),
        },
    }


@app.on_event("startup")
def on_startup():
    init_db()


@app.get("/api/hub")
def get_hub():
    """Retorna perfil, preferências e métricas consolidadas numa única chamada."""
    with get_db() as conn:
        return serialize_hub_state(conn)


@app.put("/api/profile")
def update_profile(payload: ProfileUpdatePayload):
    """Atualiza dados do perfil e preferências de leitura/áudio de forma atômica."""
    clean_interests = [i.strip() for i in payload.interests if i.strip()]
    with get_db() as conn:
        conn.execute(
            """
            UPDATE user_profile
            SET display_name = ?,
                avatar_url = ?,
                bio = ?,
                interests_json = ?,
                audio_language = ?,
                reader_theme = ?
            WHERE id = 1
            """,
            (
                payload.display_name.strip(),
                (payload.avatar_url or "").strip(),
                payload.bio.strip(),
                json.dumps(clean_interests, ensure_ascii=False),
                payload.audio_language,
                payload.reader_theme,
            ),
        )
        return serialize_hub_state(conn)


@app.get("/api/items")
def list_items(
    section: str = Query("history"),
    subfilter: str = Query("Todos"),
    q: str = Query(""),
):
    """Filtra itens de qualquer aba com suporte a subcategoria e busca instantânea."""
    with get_db() as conn:
        sql = "SELECT * FROM library_items WHERE 1=1"
        params: list = []

        if section != "history":
            sql += " AND section = ?"
            params.append(section)

        if subfilter and subfilter != "Todos":
            sql += " AND (category = ? OR status = ?)"
            params.extend([subfilter, subfilter])

        if q.strip():
            sql += " AND (title LIKE ? OR subtitle LIKE ?)"
            term = f"%{q.strip()}%"
            params.extend([term, term])

        sql += " ORDER BY id DESC"
        rows = conn.execute(sql, params).fetchall()
        return {"items": [dict(r) for r in rows]}


@app.post("/api/demo/toggle")
def toggle_demo_items():
    """Utilitário integrado para alternar entre estado vazio (0) e acervo populado."""
    with get_db() as conn:
        count = conn.execute("SELECT COUNT(*) FROM library_items").fetchone()[0]
        if count > 0:
            conn.execute("DELETE FROM library_items")
            seeded = False
        else:
            sample_data = [
                ("reading", "Livros", "Em Andamento", "Ficções", "Jorge Luis Borges", "Cap. 4 · Pergaminho Sépia"),
                ("downloads", "Livros", "Offline", "A Sociedade do Cansaço.epub", "Byung-Chul Han", "2.4 MB · Cache Offline"),
                ("downloads", "Mangás", "Concluídos", "Vagabond — Vol. 01.pdf", "Takehiko Inoue", "48.1 MB · Concluído"),
                ("cinema", "Filmes & Séries", "Concluídos", "Stalker (1979)", "Andrei Tarkovsky", "Áudio Original · 162 min"),
                ("cinema", "Animes", "Em Andamento", "Monster — Ep. 18", "Naoki Urasawa", "Português · 24 min"),
                ("shelf", "Livros", "Concluídos", "Solaris", "Stanisław Lem", "Guardado na Estante"),
                ("reviews", "Filmes & Séries", "Concluídos", "Blade Runner 2049", "Denis Villeneuve", "Ensaio crítico publicado"),
            ]
            conn.executemany(
                """
                INSERT INTO library_items (section, category, status, title, subtitle, meta)
                VALUES (?, ?, ?, ?, ?, ?)
                """,
                sample_data,
            )
            seeded = True

        state = serialize_hub_state(conn)
        state["seeded"] = seeded
        return state


