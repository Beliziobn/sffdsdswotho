    flex-direction: column;
    gap: 6px;
    max-height: 540px;
    overflow-y: auto;
  }
  .book-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 11px;
    cursor: pointer;
    transition: background 0.15s;
