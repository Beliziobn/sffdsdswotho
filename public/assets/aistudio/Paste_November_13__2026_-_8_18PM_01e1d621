<script>
  let booksCache = [];
  let selectedBookId = null;
  let visibleSyndicationIds = [];
  let currentTopic = 'todos';

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2600);
  }

  function switchTab(tab) {
    document.querySelectorAll('.nav-tab').forEach(b => {
      b.classList.toggle('active', b.dataset.tab === tab);
    });
    ['overview', 'news', 'syndication', 'library', 'geek'].forEach(v => {
      document.getElementById('view-' + v).classList.toggle('hidden', v !== tab);
    });
    if (tab === 'library' && booksCache.length === 0) loadBooks();
    if (tab === 'syndication') loadSyndication(currentTopic);
  }

  async function loadOverview() {
    const res = await fetch('/api/overview');
    const data = await res.json();

    document.getElementById('kpi-news').textContent = data.kpis.news_total;
    document.getElementById('nav-news-count').textContent = data.kpis.news_total;
    document.getElementById('kpi-news-sub').textContent = `${data.kpis.news_deep} aprofundadas`;
    document.getElementById('kpi-books').textContent = data.kpis.books_total;
    document.getElementById('nav-books-count').textContent = data.kpis.books_total;
    document.getElementById('kpi-health').textContent = `${data.kpis.health_pct}%`;

    // Categorias
    const catBox = document.getElementById('categories-container');
    catBox.innerHTML = data.categories.map(c => `
      <div class="cat-row">
        <div class="cat-head">
          <span class="cat-name">${c.name}</span>
          <span class="cat-stat">${c.pct}%</span>
        </div>
        <div class="bar-track"><div class="bar-fill" style="width:${c.pct}%"></div></div>
      </div>
    `).join('');

    // Pendentes de Aprimoramento
    const pList = document.getElementById('pending-list');
    document.getElementById('pending-counter').textContent = `${data.pending_articles.length} na fila`;
    if (data.pending_articles.length === 0) {
      pList.innerHTML = `<div style="padding:28px 0;text-align:center;color:var(--ink-tertiary);font-size:13.5px">Todas as publicações recentes já foram otimizadas.</div>`;
    } else {
      pList.innerHTML = data.pending_articles.map(a => `
        <div class="queue-item">
          <div class="queue-info">
            <span class="tag-pill">${a.category} · ${Math.max(3, Math.round(a.chars / 1800))} min</span>
            <div class="queue-title">${a.title}</div>
          </div>
          <div class="queue-actions">
            <button class="btn btn-primary btn-sm" onclick="enhanceArticle(${a.id})">Aprimorar</button>
          </div>
        </div>
      `).join('');
    }

    // Lista Completa aba Notícias
    document.getElementById('all-news-list').innerHTML = data.all_articles.map(a => `
      <div class="queue-item">
        <div class="queue-info">
          <span class="tag-pill">${a.category}</span>
          <div class="queue-title">${a.title}</div>
        </div>
        <span style="font-size:12px;color:var(--ink-tertiary)">${a.enhanced ? 'Verificada' : 'Pendente'}</span>
      </div>
    `).join('');
  }

  async function enhanceArticle(id) {
    await fetch(`/api/articles/${id}/enhance`, { method: 'POST' });
    showToast('Estrutura editorial aprimorada com sucesso');
    loadOverview();
  }

  async function loadBooks() {
    const res = await fetch('/api/books');
    booksCache = await res.json();
    if (booksCache.length > 0 && !selectedBookId) {
      selectBook(booksCache[0].id);
    } else {
      renderBookList();
    }
  }

  function renderBookList() {
    const q = (document.getElementById('book-search').value || '').toLowerCase();
    const filtered = booksCache.filter(b =>
      b.title.toLowerCase().includes(q) || b.author.toLowerCase().includes(q)
    );
    document.getElementById('book-list').innerHTML = filtered.map(b => `
      <div class="book-item ${b.id === selectedBookId ? 'active' : ''}" onclick="selectBook(${b.id})">
        <img class="book-thumb" src="${b.cover_url}" alt="">
        <div class="book-meta">
          <div class="book-item-title">${b.title}</div>
          <div class="book-item-author">${b.author}</div>
        </div>
      </div>
    `).join('');
  }

  function selectBook(id) {
    selectedBookId = id;
    const b = booksCache.find(x => x.id === id);
    if (!b) return;
    document.getElementById('editor-heading').textContent = 'Editar Obra';
    document.getElementById('book-title').value = b.title;
    document.getElementById('book-author').value = b.author;
    document.getElementById('book-category').value = b.category;
    document.getElementById('book-cover').value = b.cover_url;
    document.getElementById('book-pdf').value = b.pdf_url || '';
    document.getElementById('book-synopsis').value = b.synopsis || '';
    renderBookList();
  }

  function newBookForm() {
    selectedBookId = null;
    document.getElementById('editor-heading').textContent = 'Nova Obra';
    ['book-title', 'book-author', 'book-category', 'book-cover', 'book-pdf', 'book-synopsis']
      .forEach(id => document.getElementById(id).value = '');
    renderBookList();
  }

  async function saveBook() {
    const payload = {
      title: document.getElementById('book-title').value.trim(),
      author: document.getElementById('book-author').value.trim() || 'Autor Editorial',
      category: document.getElementById('book-category').value.trim() || 'Geral',
      cover_url: document.getElementById('book-cover').value.trim(),
      pdf_url: document.getElementById('book-pdf').value.trim(),
      synopsis: document.getElementById('book-synopsis').value.trim(),
    };
    if (!payload.title) return showToast('Informe o título da obra');

    if (selectedBookId) {
      await fetch(`/api/books/${selectedBookId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      showToast('Obra atualizada na nuvem');
    } else {
      const res = await fetch('/api/books', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const out = await res.json();
      selectedBookId = out.id;
      showToast('Nova obra adicionada à biblioteca');
    }
    await loadBooks();
    loadOverview();
  }

  async function handlePdfUpload(ev) {
    const file = ev.target.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('file', file);
    const res = await fetch('/api/books/parse-pdf', { method: 'POST', body: fd });
    const meta = await res.json();

    document.getElementById('book-title').value = meta.extracted_title;
    document.getElementById('book-synopsis').value = meta.suggested_synopsis;
    showToast(`PDF lido · ${meta.pages} páginas detectadas`);
  }

  async function loadSyndication(topic) {
    currentTopic = topic;
    const res = await fetch(`/api/syndication?topic=${topic}`);
    const items = await res.json();
    visibleSyndicationIds = items.map(i => i.id);

    const btnBatch = document.getElementById('btn-publish-batch');
    btnBatch.textContent = items.length ? `Publicar Lote (${items.length})` : 'Lote Vazio';
    btnBatch.disabled = items.length === 0;

    const grid = document.getElementById('syndication-grid');
    if (items.length === 0) {
      grid.innerHTML = `<div class="card section-box" style="grid-column:1/-1;text-align:center;color:var(--ink-tertiary)">Todos os artigos desta editoria já foram publicados no site.</div>`;
      return;
    }
    grid.innerHTML = items.map(item => `
      <article class="card media-card">
        <div class="media-img-wrap">
          <img class="media-img" src="${item.image_url}" alt="">
          <span class="glass-badge">${item.category_label}</span>
        </div>
        <div class="media-body">
          <h3 class="media-title">${item.title}</h3>
          <div class="media-footer">
            <span>Leitura · ${item.read_time}</span>
            <button class="btn btn-secondary btn-sm" onclick="publishSingle(${item.id})">Publicar</button>
          </div>
        </div>
      </article>
    `).join('');
  }

  function filterSyndication(topic, el) {
    document.querySelectorAll('.pill-filter').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    loadSyndication(topic);
  }

  async function publishSingle(id) {
    await fetch('/api/syndication/publish', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify([id])
    });
    showToast('Artigo publicado no site');
    loadSyndication(currentTopic);
    loadOverview();
  }

  async function publishAllVisible() {
    if (!visibleSyndicationIds.length) return;
    await fetch('/api/syndication/publish', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(visibleSyndicationIds)
    });
    showToast(`${visibleSyndicationIds.length} publicações integradas ao acervo`);
    loadSyndication(currentTopic);
    loadOverview();
  }

  async function syncCloud() {
    const res = await fetch('/api/cloud/sync', { method: 'POST' });
    const data = await res.json();
    document.getElementById('sync-time').textContent = `· Sincronizado às ${data.time}`;
    showToast('Nuvem sincronizada em tempo real');
  }

  function openModal() { document.getElementById('pub-modal').classList.add('open'); }
  function closeModal() { document.getElementById('pub-modal').classList.remove('open'); }

  async function submitArticle() {
    const title = document.getElementById('new-art-title').value.trim();
    const category = document.getElementById('new-art-cat').value.trim() || 'Geral';
    const summary = document.getElementById('new-art-summary').value.trim();
    if (!title) return showToast('Digite o título principal');

    await fetch('/api/articles', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title, category, summary })
    });
    document.getElementById('new-art-title').value = '';
    document.getElementById('new-art-summary').value = '';
    closeModal();
    showToast('Publicação enviada para a nuvem');
    loadOverview();
  }

  loadOverview();
</script>
</body>
</html>
"""


