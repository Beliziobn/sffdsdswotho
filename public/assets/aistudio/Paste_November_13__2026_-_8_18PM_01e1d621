@app.post("/api/articles")
def create_article(payload: ArticleCreate):
    conn = get_db()
    now = datetime.now().strftime("%d %b %Y, %H:%M")
    chars = max(3200, len(payload.summary or "") * 18 + 4200)
    conn.execute(
        "INSERT INTO articles (title, category, chars, enhanced, summary, created_at) VALUES (?, ?, ?, 1, ?, ?)",
        (payload.title.strip(), payload.category.strip(), chars, payload.summary, now),
    )
    conn.commit()
    conn.close()
    return {"status": "ok"}


@app.post("/api/articles/{article_id}/enhance")
def enhance_article(article_id: int):
    conn = get_db()
    row = conn.execute("SELECT * FROM articles WHERE id = ?", (article_id,)).fetchone()
    if not row:
        conn.close()
        raise HTTPException(status_code=404, detail="Matéria não encontrada")

    new_chars = int(row["chars"] * 1.22)
    conn.execute(
        "UPDATE articles SET enhanced = 1, chars = ? WHERE id = ?",
        (new_chars, article_id),
    )
    conn.commit()
    conn.close()
    return {"status": "enhanced", "new_chars": new_chars}


