  /* RANKING TIPOGRÁFICO ESCULTURAL */
  .rank-strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
    gap: 16px;
    margin-bottom: 64px;
  }
  .rank-item {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    transition: all 0.25s var(--ease-spring);
  }
  .rank-item:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .rank-num {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.05em;
    color: rgba(29, 29, 31, 0.18);
    min-width: 28px;
    text-align: center;
  }
  .rank-thumb {
    width: 48px;
    height: 68px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--hairline);
  }
  .rank-thumb img { width: 100%; height: 100%; object-fit: cover; }

  /* SIMULCAST HORIZON */
  .simulcast-box {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    padding: 28px;
    box-shadow: var(--shadow-sm);
  }
  .simulcast-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 14px;
    margin-top: 18px;
  }
  .sim-card {
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--hairline);
    background: var(--canvas);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* ==========================================================================
     PÁGINA UNIFICADA DA OBRA (SUBSTITUI IMAGENS 2 E 3 SEM REDUNDÂNCIA)
     ========================================================================== */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-secondary);
    cursor: pointer;
    margin-bottom: 22px;
    border: none;
    background: none;
  }
  .back-link:hover { color: var(--ink); }

  .work-hero {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 42px;
    align-items: start;
    margin-bottom: 36px;
  }
  .work-poster-card {
    width: 240px;
    aspect-ratio: 2 / 3;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--hairline);
  }
  .work-poster-card img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .meta-whisper-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-secondary);
    margin-bottom: 10px;
  }
  .badge-status {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--emerald-soft);
    color: var(--emerald);
  }
  .work-display-title {
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: 6px;
  }
  .work-jp-sub {
    font-size: 14px;
    color: var(--ink-secondary);
    margin-bottom: 16px;
  }
  .genre-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }
  .genre-pill {
    font-size: 12px;
    padding: 4px 11px;
    border-radius: var(--radius-pill);
    background: rgba(29, 29, 31, 0.05);
    color: var(--ink-secondary);
    font-weight: 500;
  }
  .work-synopsis {
    font-size: 15px;
    line-height: 1.62;
    color: #3A3A3C;
    max-width: 760px;
    margin-bottom: 24px;
  }

  /* Cluster Único de Ação (Substitui os 5 botões empilhados + cards repetidos) */
  .action-cluster {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }

  /* Faixa CanonBridge Inteligente */
  .canon-bridge-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid rgba(0, 102, 204, 0.18);
    box-shadow: var(--shadow-sm);
    max-width: 760px;
  }
  .cb-left {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13.5px;
  }
  .cb-icon {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--accent-soft);
    color: var(--accent);
    display: grid;
    place-items: center;
    font-weight: 700;
  }

  /* Ficha Técnica Horizontal Limpa (Sob demanda ou discreta) */
  .spec-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    margin-bottom: 28px;
  }
  .spec-cell span { display: block; font-size: 11px; color: var(--ink-tertiary); text-transform: uppercase; letter-spacing: 0.05em; }
  .spec-cell strong { font-size: 13.5px; font-weight: 600; color: var(--ink); }

  /* PALCO CINEMA PLAYER (EXPANSÍVEL E LIMPO) */
  .cinema-stage {
    background: #0B0C10;
    color: #FFF;
    border-radius: var(--radius-lg);
    padding: 22px 24px;
    margin-bottom: 28px;
    box-shadow: var(--shadow-lg);
  }
  .cinema-screen {
    aspect-ratio: 21 / 9;
    max-height: 380px;
    width: 100%;
    border-radius: 14px;
    background: radial-gradient(circle at 50% 40%, rgba(var(--ambient-rgb), 0.35), #050507 78%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    position: relative;
    margin-bottom: 16px;
  }
  .cinema-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .audio-popover-wrap { position: relative; }
  .audio-pill {
    height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #FFF;
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .audio-popover {
    position: absolute;
    right: 0;
    bottom: 46px;
    width: 360px;
    background: rgba(28, 28, 32, 0.96);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    padding: 16px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    box-shadow: var(--shadow-lg);
    z-index: 50;
  }
  .pop-col h5 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 8px;
  }
  .pop-opt {
    display: block;
    width: 100%;
    text-align: left;
    padding: 6px 9px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    font-size: 12.5px;
    cursor: pointer;
  }
  .pop-opt:hover { background: rgba(255, 255, 255, 0.08); }
  .pop-opt.selected { background: var(--accent); color: #FFF; font-weight: 600; }

  /* SELETOR DE SAGAS HORIZONTAL */
  .saga-strip {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 8px;
    margin-bottom: 20px;
  }
  .saga-pill {
    flex-shrink: 0;
    text-align: left;
    padding: 12px 16px;
    border-radius: 14px;
    border: 1px solid var(--hairline);
    background: var(--surface);
    cursor: pointer;
    min-width: 210px;
    transition: all 0.2s var(--ease-spring);
  }
  .saga-pill:hover { border-color: rgba(0, 0, 0, 0.18); }
  .saga-pill.active {
    background: var(--ink);
    color: #FFF;
    border-color: var(--ink);
  }
  .saga-pill small { display: block; font-size: 11px; opacity: 0.68; margin-bottom: 2px; }
  .saga-pill strong { display: block; font-size: 13.5px; letter-spacing: -0.01em; }

  /* CONTROLES DE EPISÓDIOS (CANON FILTER + DENSIDADE + BUSCA) */
  .media-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }
  .inline-input {
    height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hairline);
    background: var(--surface);
    font-size: 13px;
    min-width: 230px;
    outline: none;
  }
  .inline-input:focus { border-color: var(--accent); }

  /* LISTA EDITORIAL DE EPISÓDIOS (SEM SHA256 EXPOSTO E SEM TEXTO REPETIDO) */
  .ep-list { display: flex; flex-direction: column; gap: 10px; }
  .ep-row {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    padding: 16px 20px;
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 18px;
    align-items: center;
    transition: all 0.2s var(--ease-spring);
  }
  .ep-row:hover { border-color: rgba(0, 0, 0, 0.14); box-shadow: var(--shadow-sm); }
  .ep-row.playing { border-color: var(--accent); background: #FBFDFF; }
  .ep-num-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--canvas);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
  }
  .ep-row.playing .ep-num-box { background: var(--accent); color: #FFF; }
  .ep-tags { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; font-size: 11.5px; }
  .tag-canon { color: var(--emerald); font-weight: 600; }
  .tag-filler { color: #B45309; font-weight: 600; }
  .tag-bridge {
    color: var(--accent);
    background: var(--accent-soft);
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    cursor: pointer;
    border: none;
    font-size: 11px;
  }
  .ep-title { font-size: 15px; font-weight: 600; letter-spacing: -0.015em; margin-bottom: 3px; }
  .ep-desc { font-size: 13px; color: var(--ink-secondary); line-height: 1.45; }
  .ep-actions { display: flex; align-items: center; gap: 8px; }

  /* GRADE COMPACTA DE EPISÓDIOS (PARA OBRAS LONGAS DE 1000+ EPS) */
  .ep-compact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
  .ep-tile {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    padding: 12px;
    cursor: pointer;
    text-align: left;
    transition: all 0.18s var(--ease-spring);
  }
  .ep-tile:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .ep-tile.playing { border-color: var(--accent); background: var(--accent-soft); }

  /* MODAIS: SPOTLIGHT (Cmd+K) & LEITOR ZEN DE MANGÁ */
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 15, 20, 0.45);
    backdrop-filter: blur(10px);
    z-index: 200;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 80px 20px 20px;
  }
  .overlay.open { display: flex; }
  .spotlight-modal {
    width: 100%;
    max-width: 620px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(28px);
    border: 1px solid var(--hairline);
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .spotlight-input {
    width: 100%;
    height: 58px;
    padding: 0 22px;
    border: none;
    border-bottom: 1px solid var(--hairline);
    background: transparent;
    font-size: 16px;
    outline: none;
  }
  .spotlight-results { max-height: 380px; overflow-y: auto; padding: 8px; }
  .spot-item {
    padding: 11px 14px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }
  .spot-item:hover { background: rgba(0, 102, 204, 0.08); }

  /* Leitor Zen de Mangá */
  .zen-modal {
    width: 100%;
    max-width: 760px;
    background: #FAF9F5;
    border-radius: 22px;
    padding: 32px 36px;
    box-shadow: var(--shadow-lg);
    max-height: 84vh;
    overflow-y: auto;
  }
  .zen-page {
    background: #FFF;
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 32px;
    margin: 20px 0;
    font-size: 16px;
    line-height: 1.8;
    color: #222;
  }

  /* Toast Discreto */
  .toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 300;
    background: rgba(29, 29, 31, 0.92);
    backdrop-filter: blur(16px);
    color: #FFF;
    padding: 11px 18px;
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 500;
    box-shadow: var(--shadow-md);
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: all 0.25s var(--ease-spring);
  }
  .toast.show { opacity: 1; transform: translateY(0); }

  @media (max-width: 860px) {
    .hero-stage { grid-template-columns: 1fr; padding: 26px; }
    .hero-poster-wrap { display: none; }
    .bento-grid { grid-template-columns: 1fr; }
    .work-hero { grid-template-columns: 1fr; }
    .work-poster-card { width: 170px; }
    .ep-row { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
</head>
<body>

<div class="ambient-wash" id="ambientWash"></div>

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" onclick="App.goCatalog()">
      <span class="brand-mark">W</span>
      <span>Wotho</span>
      <span class="brand-tag">CanonBridge™ UI</span>
    </a>

    <button class="spotlight-trigger" onclick="App.openSpotlight()">
      <span>Buscar obra, estúdio, "ep 4" ou "cap 8"...</span>
      <kbd class="kbd">⌘K</kbd>
    </button>
  </div>
</header>

<main class="shell" id="appRoot"></main>

<!-- MODAL SPOTLIGHT (⌘K) -->
<div class="overlay" id="spotlightOverlay" onclick="if(event.target===this) App.closeSpotlight()">
  <div class="spotlight-modal">
    <input type="text" class="spotlight-input" id="spotlightInput"
           placeholder="Digite ex: One Piece, Frieren, ep 4, cap 8, Egghead, Madhouse..."
           oninput="App.onSpotlightInput(this.value)" />
    <div class="spotlight-results" id="spotlightResults"></div>
  </div>
</div>

<!-- MODAL LEITOR ZEN DE MANGÁ (COM PONTE DIRETA PARA O ANIME) -->
<div class="overlay" id="zenOverlay" onclick="if(event.target===this) App.closeZen()">
  <div class="zen-modal" id="zenContent"></div>
</div>

<div class="toast" id="toastBox"></div>

<script>
const App = {
  boot: null,
  view: 'catalog',
  heroIndex: 0,
  activeFilter: 'todos',
  activeDay: 'Sábado',
  currentWork: null,
  workTab: 'anime',        // 'anime' | 'manga'
  activeSaga: 'all',
  onlyCanon: false,
  compactDensity: false,
  epQuery: '',
  showSpecs: false,
  showAudioPop: false,

  async init() {
    const res = await fetch('/api/bootstrap');
    this.boot = await res.json();
    this.setupShortcuts();
    this.render();
  },

  setupShortcuts() {
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        this.openSpotlight();
      } else if (e.key === '/' && document.activeElement.tagName !== 'INPUT') {
        e.preventDefault();
        this.openSpotlight();
      } else if (e.key === 'Escape') {
        this.closeSpotlight();
        this.closeZen();
      }
    });
  },

  setAmbient(rgb) {
    document.getElementById('ambientWash').style.setProperty('--ambient-rgb', rgb || '79, 118, 168');
    document.documentElement.style.setProperty('--ambient-rgb', rgb || '79, 118, 168');
  },

  toast(msg) {
    const el = document.getElementById('toastBox');
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(this._tTimer);
    this._tTimer = setTimeout(() => el.classList.remove('show'), 2800);
  },

  goCatalog() {
    this.view = 'catalog';
    this.currentWork = null;
    window.scrollTo({ top: 0, behavior: 'smooth' });
    this.render();
  },

  async openWork(slug, initialTab = 'anime', targetNum = null) {
    const res = await fetch(`/api/work/${slug}`);
    if (!res.ok) return;
    this.currentWork = await res.json();
    this.view = 'work';
    this.workTab = this.currentWork.is_original_anime ? 'anime' : initialTab;
    this.activeSaga = 'all';
    this.epQuery = '';
    this.showAudioPop = false;

    if (targetNum !== null) {
      if (this.workTab === 'anime') {
        await this.selectEpisode(targetNum, false);
      } else {
        await this.openZenChapter(targetNum);
      }
    }
    this.setAmbient(this.currentWork.ambient_rgb);
    window.scrollTo({ top: 0, behavior: 'smooth' });
    this.render();
  },

  // ==========================================================================
  // RENDERIZAÇÃO PRINCIPAL
  // ==========================================================================
  render() {
    const root = document.getElementById('appRoot');
    if (this.view === 'catalog') {
      root.innerHTML = this.renderCatalogHTML();
    } else if (this.view === 'work' && this.currentWork) {
      root.innerHTML = this.renderWorkHTML();
    }
  },

  renderCatalogHTML() {
    const featuredSlugs = this.boot.featured_slugs;
    const heroSlug = featuredSlugs[this.heroIndex % featuredSlugs.length];
    const hero = this.boot.catalog.find(w => w.slug === heroSlug) || this.boot.catalog[0];
    this.setAmbient(hero.ambient_rgb);

    const wl = this.boot.user_state.watchlist || [];
    const filtered = this.boot.catalog.filter(w => {
      if (this.activeFilter === 'todos') return true;
      if (this.activeFilter === 'lista') return wl.includes(w.slug);
      return w.categories.includes(this.activeFilter);
    });

    const filters = [
      ['todos', `Explorar (${this.boot.catalog.length})`],
      ['seinen', 'Obras Profundas & Seinen'],
      ['lancamento', 'Em Lançamento'],
      ['bimodal', 'Sincronia Anime ⇄ Mangá'],
      ['completos', 'Séries Completas'],
      ['lista', `Minha Lista (${wl.length})`],
    ];

    const days = ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado', 'Domingo'];
    const dayItems = this.boot.schedule[this.activeDay] || [];

    return `
      <!-- PALCO EDITORIAL HERO -->
      <section class="hero-stage">
        <div>
          <div class="hero-eyebrow">
            <span class="pulse-dot"></span>
            <span>Destaque Curatorial • ${hero.studio} • ★ ${hero.rating}</span>
          </div>
          <h1 class="hero-title">${hero.title}</h1>
          <p class="hero-logline">${hero.logline}</p>
          <div class="hero-actions">
            <button class="btn btn-primary" onclick="App.openWork('${hero.slug}', 'anime')">
              ▶ Assistir Agora
            </button>
            ${!hero.is_original_anime ? `
              <button class="btn btn-bridge" onclick="App.openWork('${hero.slug}', 'manga')">
                ⇄ CanonBridge: Ler Mangá (${hero.total_chapters} caps)
              </button>
            ` : ''}
            <button class="icon-btn ${wl.includes(hero.slug) ? 'active' : ''}"
                    title="Salvar na Minha Lista"
                    onclick="App.toggleWatchlist('${hero.slug}')">
              🔖
            </button>
          </div>
          <div class="hero-switcher">
            ${featuredSlugs.map((_, idx) => `
              <button class="hero-dot ${idx === this.heroIndex ? 'active' : ''}"
                      onclick="App.heroIndex=${idx}; App.render()"></button>
            `).join('')}
          </div>
        </div>
        <div class="hero-poster-wrap" onclick="App.openWork('${hero.slug}', 'anime')">
          <img src="${hero.poster_url}" alt="${hero.title}" loading="eager" />
        </div>
      </section>

      <!-- CATÁLOGO PRINCIPAL COM FILTRO SEGMENTADO -->
      <div class="section-head">
        <div>
          <h2 class="section-title">Acervo Oficial</h2>
          <p class="section-sub">Pôsteres limpos em repouso; ações bimodais reveladas sob intenção.</p>
        </div>
      </div>

      <div class="filter-bar">
        ${filters.map(([id, label]) => `
          <button class="seg-btn ${this.activeFilter === id ? 'active' : ''}"
                  onclick="App.activeFilter='${id}'; App.render()">${label}</button>
        `).join('')}
      </div>

      <section class="poster-grid">
        ${filtered.length ? filtered.map(w => `
          <article class="work-card" onclick="App.openWork('${w.slug}', 'anime')">
            <div class="poster-frame">
              <img src="${w.poster_url}" alt="${w.title}" loading="lazy" />
              <span class="poster-whisper">★ ${w.rating}</span>
              ${!w.is_original_anime ? `<span class="poster-bimodal" title="Sincronia Anime + Mangá">⇄</span>` : ''}
              <div class="quick-lens" onclick="event.stopPropagation()">
                <div class="quick-lens-text">${w.logline}</div>
                <div class="quick-lens-btns">
                  <button class="ql-btn" onclick="App.openWork('${w.slug}', 'anime')">▶ Anime</button>
                  ${!w.is_original_anime
                    ? `<button class="ql-btn alt" onclick="App.openWork('${w.slug}', 'manga')">📖 Mangá</button>`
                    : `<button class="ql-btn alt" onclick="App.openWork('${w.slug}', 'anime')">✦ Original</button>`
                  }
                </div>
              </div>
            </div>
            <div>
              <h3 class="card-meta-title">${w.title}</h3>
              <p class="card-meta-sub">${w.studio} • ${w.year}</p>
            </div>
          </article>
        `).join('') : `<p style="color:var(--ink-secondary);grid-column:1/-1;padding:24px 0;">Nenhuma obra neste filtro ainda.</p>`}
      </section>

      <!-- CADÊNCIA BENTO: OBRAS QUE TRANSFORMAM A VISÃO DE MUNDO -->
      <div class="section-head">
        <div>
          <h2 class="section-title">Obras Profundas que Transformam a Visão de Mundo</h2>
          <p class="section-sub">Curadoria Seinen, Filosófica e Psicológica em formato editorial respirável.</p>
        </div>
      </div>
      <section class="bento-grid">
        ${this.boot.philosophical.slice(0, 4).map(w => `
          <article class="bento-card" onclick="App.openWork('${w.slug}', 'anime')">
            <div class="bento-poster">
              <img src="${w.poster_url}" alt="${w.title}" loading="lazy" />
            </div>
            <div>
              <div style="font-size:11.5px;font-weight:600;color:var(--ink-tertiary);text-transform:uppercase;letter-spacing:0.05em;">
                ${w.studio} • ★ ${w.rating}
              </div>
              <h3 style="font-size:18px;font-weight:700;letter-spacing:-0.02em;margin-top:2px;">${w.title}</h3>
              <blockquote class="bento-quote">“${w.philosophical_quote}”</blockquote>
              <span style="font-size:12.5px;font-weight:600;color:var(--accent);">Explorar obra completa →</span>
            </div>
          </article>
        `).join('')}
      </section>

      <!-- RANKING TIPOGRÁFICO LIMPO -->
      <div class="section-head">
        <div>
          <h2 class="section-title">Mais Assistidos da Temporada</h2>
          <p class="section-sub">Hierarquia tipográfica clara, sem sobrepor números gigantes nas artes.</p>
        </div>
      </div>
      <section class="rank-strip">
        ${this.boot.ranking.map(w => `
          <div class="rank-item" onclick="App.openWork('${w.slug}', 'anime')">
            <span class="rank-num">${w.rank_position}</span>
            <div class="rank-thumb"><img src="${w.poster_url}" alt="${w.title}" /></div>
            <div style="min-width:0;">
              <div class="card-meta-title">${w.title}</div>
              <div class="card-meta-sub">${w.studio} • ★ ${w.rating}</div>
            </div>
          </div>
        `).join('')}
      </section>

      <!-- HORIZONTE SIMULCAST SEMANAL -->
      <section class="simulcast-box">
        <div class="section-head" style="margin-bottom:12px;">
          <div>
            <h2 class="section-title">Horizonte Simulcast</h2>
            <p class="section-sub">Estreias semanais com lembrete em 1 clique.</p>
          </div>
        </div>
        <div class="filter-bar" style="margin-bottom:8px;">
          ${days.map(d => `
            <button class="seg-btn ${this.activeDay === d ? 'active' : ''}"
                    onclick="App.activeDay='${d}'; App.render()">${d}</button>
          `).join('')}
        </div>
        <div class="simulcast-cards">
          ${dayItems.map(item => {
            const reminded = (this.boot.user_state.reminders || []).includes(item.slug);
            return `
              <div class="sim-card">
                <div style="cursor:pointer;" onclick="App.openWork('${item.slug}', 'anime')">
                  <div style="font-size:11px;font-weight:600;color:var(--emerald);">${item.time}</div>
                  <div style="font-size:14px;font-weight:600;margin:2px 0;">${item.title}</div>
                  <div style="font-size:12px;color:var(--ink-secondary);">${item.studio} • ${item.episodes} eps</div>
                </div>
                <button class="icon-btn ${reminded ? 'active' : ''}" style="width:36px;height:36px;font-size:13px;"
                        title="Ativar lembrete de episódio"
                        onclick="App.toggleReminder('${item.slug}')">
                  🔔
                </button>
              </div>
