def render_criterion_poster_svg(work: MediaWork) -> str:
    """
    Gera pôsteres vetoriais editoriais de alta definição (inspirados na Criterion Collection),
    garantindo zero links quebrados offline, carregamento instantâneo (<1ms) e coesão cromática.
    Em produção, basta preencher `poster_url` no MediaWork para usar imagens de CDN.
    """
    palettes = {
        "sunburst": ("#0F172A", "#1E3A5F", "#F59E0B", "#FDE68A"),
        "moonpetals": ("#0F172A", "#1E293B", "#7DD3FC", "#E0F2FE"),
        "astrolabe": ("#090D16", "#1E1B4B", "#818CF8", "#C7D2FE"),
        "eclipse": ("#09090B", "#18181B", "#A1A1AA", "#F4F4F5"),
        "shadow": ("#070614", "#1E1B4B", "#6366F1", "#A5B4FC"),
        "waves": ("#06181A", "#11383D", "#2DD4BF", "#CCFBF1"),
        "cyber": ("#12081C", "#2E1065", "#F43F5E", "#FDE047"),
    }
    bg1, bg2, acc1, acc2 = palettes.get(work.art_motif, palettes["moonpetals"])
    jp_clean = html.escape(work.jp_title.split("•")[0].strip()[:14])
    studio_clean = html.escape(work.studio.upper())
    year_clean = str(work.year)

    # Geometria artística exclusiva por motivo temático
    motif_svg = ""
    if work.art_motif == "sunburst":
        motif_svg = f"""
        <circle cx="300" cy="390" r="155" fill="url(#glow)" opacity="0.92"/>
        <circle cx="300" cy="390" r="105" fill="none" stroke="{acc2}" stroke-width="1.5" opacity="0.55"/>
        <path d="M 60 540 Q 300 470 540 540 L 600 900 L 0 900 Z" fill="{bg1}" opacity="0.88"/>
        <path d="M 110 585 Q 300 535 490 585" fill="none" stroke="{acc1}" stroke-width="1.5" opacity="0.45"/>
        """
    elif work.art_motif == "astrolabe":
        motif_svg = f"""
        <circle cx="300" cy="400" r="195" fill="none" stroke="{acc1}" stroke-width="1" stroke-dasharray="4 8" opacity="0.5"/>
        <circle cx="300" cy="400" r="140" fill="none" stroke="{acc2}" stroke-width="1.2" opacity="0.65"/>
        <ellipse cx="300" cy="400" rx="210" ry="72" transform="rotate(-28 300 400)" fill="none" stroke="{acc1}" stroke-width="1.4" opacity="0.6"/>
        <circle cx="300" cy="400" r="22" fill="{acc2}"/>
        <circle cx="425" cy="332" r="7" fill="{acc1}"/>
        """
    elif work.art_motif == "eclipse":
        motif_svg = f"""
        <circle cx="300" cy="400" r="148" fill="{acc2}" opacity="0.9"/>
        <circle cx="308" cy="396" r="144" fill="{bg1}"/>
        <circle cx="300" cy="400" r="190" fill="none" stroke="{acc1}" stroke-width="0.8" opacity="0.35"/>
        """
    elif work.art_motif == "shadow":
        motif_svg = f"""
        <polygon points="300,190 450,430 300,640 150,430" fill="url(#glow)" opacity="0.65"/>
        <polygon points="300,235 410,430 300,595 190,430" fill="none" stroke="{acc2}" stroke-width="1.4" opacity="0.7"/>
        <circle cx="300" cy="410" r="38" fill="{acc2}" opacity="0.85"/>
        """
    elif work.art_motif == "cyber":
        motif_svg = f"""
        <circle cx="360" cy="340" r="135" fill="{acc2}" opacity="0.88"/>
        <rect x="85" y="420" width="430" height="3" fill="{acc1}" opacity="0.85"/>
        <rect x="135" y="445" width="330" height="1.5" fill="{acc2}" opacity="0.55"/>
        <polygon points="120,700 260,420 480,700" fill="{bg1}" opacity="0.82"/>
        """
    else:  # moonpetals / waves
        motif_svg = f"""
        <circle cx="300" cy="360" r="138" fill="url(#glow)" opacity="0.85"/>
        <path d="M 300 222 A 138 138 0 1 0 422 425 A 112 112 0 1 1 300 222 Z" fill="{acc2}" opacity="0.9"/>
        <circle cx="220" cy="510" r="4" fill="{acc2}" opacity="0.7"/>
        <circle cx="385" cy="475" r="3" fill="{acc1}" opacity="0.8"/>
        <circle cx="330" cy="555" r="5" fill="{acc2}" opacity="0.5"/>
        """

    return f"""<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 900" width="600" height="900">
    <defs>
        <linearGradient id="bg" x1="0" y1="0" x2="0.3" y2="1">
            <stop offset="0%" stop-color="{bg2}"/>
            <stop offset="100%" stop-color="{bg1}"/>
        </linearGradient>
        <radialGradient id="glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="{acc1}" stop-opacity="0.9"/>
            <stop offset="100%" stop-color="{bg2}" stop-opacity="0"/>
        </radialGradient>
    </defs>
    <rect width="600" height="900" fill="url(#bg)"/>
    <rect x="26" y="26" width="548" height="848" rx="12" fill="none" stroke="#FFFFFF" stroke-opacity="0.11" stroke-width="1"/>
    <text x="56" y="76" fill="#FFFFFF" fill-opacity="0.55" font-family="-apple-system, BlinkMacSystemFont, Inter, sans-serif" font-size="16" font-weight="600" letter-spacing="4">{studio_clean}</text>
    <text x="544" y="76" text-anchor="end" fill="#FFFFFF" fill-opacity="0.45" font-family="-apple-system, BlinkMacSystemFont, Inter, sans-serif" font-size="16" font-weight="500" letter-spacing="2">{year_clean}</text>
    {motif_svg}
    <text x="300" y="775" text-anchor="middle" fill="#FFFFFF" fill-opacity="0.92" font-family="-apple-system, BlinkMacSystemFont, 'Hiragino Sans', sans-serif" font-size="30" font-weight="700" letter-spacing="3">{jp_clean}</text>
    <line x1="255" y1="808" x2="345" y2="808" stroke="{acc2}" stroke-opacity="0.5" stroke-width="1.5"/>
    <text x="300" y="838" text-anchor="middle" fill="#FFFFFF" fill-opacity="0.45" font-family="-apple-system, BlinkMacSystemFont, Inter, sans-serif" font-size="13" font-weight="600" letter-spacing="5">WOTHO ARCHIVE EDITION</text>
</svg>"""


