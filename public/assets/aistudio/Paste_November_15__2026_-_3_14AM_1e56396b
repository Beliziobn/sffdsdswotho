          }).join('')}
        </div>
      </section>
    `;
  },

  // ==========================================================================
  // PÁGINA DE DETALHE UNIFICADA (SUBSTITUI IMAGENS 2 E 3)
  // ==========================================================================
  renderWorkHTML() {
    const w = this.currentWork;
    const prog = w.user_progress;
    const wl = this.boot.user_state.watchlist || [];
    const cb = w.canon_bridge;

    return `
      <button class="back-link" onclick="App.goCatalog()">← Voltar ao Acervo</button>

      <!-- CABEÇALHO UNIFICADO (ZERO EMPILHAMENTO DE 5 BOTÕES NA LATERAL) -->
      <section class="work-hero">
        <div class="work-poster-card">
          <img src="${w.poster_url}" alt="${w.title}" />
        </div>

        <div>
          <div class="meta-whisper-row">
            <span class="badge-status">${w.status}</span>
            <span>★ ${w.rating} (${w.votes} avaliações)</span>
