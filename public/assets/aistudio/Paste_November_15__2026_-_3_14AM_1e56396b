            <button class="icon-btn ${wl.includes(w.slug) ? 'active' : ''}"
                    title="Salvar na Minha Lista"
                    onclick="App.toggleWatchlist('${w.slug}')">🔖</button>
            <button class="icon-btn ${this.showSpecs ? 'active' : ''}"
                    title="Ficha Técnica Completa"
                    onclick="App.showSpecs=!App.showSpecs; App.render()">ⓘ</button>
            <button class="icon-btn" title="Compartilhar link limpo"
                    onclick="App.toast('Link copiado para a área de transferência')">↗</button>
          </div>

          <!-- FAIXA INTELIGENTE CANON-BRIDGE™ -->
          <div class="canon-bridge-banner">
            <div class="cb-left">
              <div class="cb-icon">⇄</div>
              <div>
                <div style="font-weight:600;color:var(--ink);">CanonBridge™ Sincronizado</div>
                <div style="color:var(--ink-secondary);font-size:12.5px;">${cb ? cb.label : ''}</div>
              </div>
            </div>
            ${!w.is_original_anime ? `
              <div class="filter-bar" style="margin:0;">
                <button class="seg-btn ${this.workTab === 'anime' ? 'active' : ''}"
                        onclick="App.workTab='anime'; App.render()">▶ Anime (${w.total_episodes} eps)</button>
                <button class="seg-btn ${this.workTab === 'manga' ? 'active' : ''}"
                        onclick="App.workTab='manga'; App.render()">📖 Mangá (${w.total_chapters} caps)</button>
              </div>
            ` : `<span class="genre-pill">✦ Roteiro Original para Animação</span>`}
          </div>
        </div>
      </section>

      <!-- FICHA TÉCNICA SOB DEMANDA (SEM POLUIR A BARRA LATERAL PERMANENTEMENTE) -->
      ${this.showSpecs ? `
        <section class="spec-strip">
          <div class="spec-cell"><span>Autoria</span><strong>${w.author}</strong></div>
          <div class="spec-cell"><span>Estúdio</span><strong>${w.studio}</strong></div>
          <div class="spec-cell"><span>Temporadas / Sagas</span><strong>${w.total_seasons} mapeadas</strong></div>
          <div class="spec-cell"><span>Episódios</span><strong>${w.total_episodes} oficiais</strong></div>
          <div class="spec-cell"><span>Mangá</span><strong>${w.is_original_anime ? 'Obra Original' : w.total_chapters + ' capítulos'}</strong></div>
        </section>
      ` : ''}

      <div id="mediaStage">
        ${this.workTab === 'anime' ? this.renderAnimeMode(w) : this.renderMangaMode(w)}
      </div>
    `;
  },

  renderAnimeMode(w) {
    const prog = w.user_progress;
    const activeEp = w.episodes.find(e => e.number === prog.ep) || w.episodes[0];
    const hiddenFillers = w.episodes.filter(e => !e.is_canon).length;

    const filteredEps = w.episodes.filter(ep => {
      if (this.activeSaga !== 'all' && ep.saga_id !== this.activeSaga) return false;
      if (this.onlyCanon && !ep.is_canon) return false;
      if (this.epQuery) {
        const q = this.epQuery.toLowerCase();
        if (!(`${ep.number} ${ep.title} ${ep.summary}`.toLowerCase().includes(q))) return false;
      }
      return true;
    });

    return `
      <!-- PALCO PLAYER COM CONTROLE ÚNICO UNIFICADO DE ÁUDIO/LEGENDA -->
      <section class="cinema-stage">
        <div class="cinema-screen">
          <div style="font-size:11.5px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.65;margin-bottom:6px;">
            Reprodução Ativa • Episódio ${activeEp.number} (${activeEp.duration_min} min)
          </div>
          <h3 style="font-size:clamp(18px,2.4vw,26px);font-weight:700;letter-spacing:-0.02em;max-width:640px;margin-bottom:8px;">
            ${activeEp.title}
          </h3>
          <p style="font-size:13.5px;color:rgba(255,255,255,0.72);max-width:580px;">${activeEp.summary}</p>
        </div>

        <div class="cinema-bar">
          <div style="font-size:12.5px;color:rgba(255,255,255,0.72);">
            ${activeEp.is_canon ? '✦ Episódio Canônico' : '◌ Episódio Filler'}
            ${activeEp.manga_chap_end ? ` • Adapta até o Cap. ${activeEp.manga_chap_end}` : ''}
          </div>

          <!-- POPOVER ÚNICO DE ÁUDIO & LEGENDA (SUBSTITUI OS 6 BOTÕES + DROPDOWN REPETIDO) -->
          <div class="audio-popover-wrap">
            <button class="audio-pill" onclick="App.showAudioPop=!App.showAudioPop; App.render()">
              🎧 ${prog.audio} • Legenda: ${prog.sub} ▾
            </button>
            ${this.showAudioPop ? `
              <div class="audio-popover">
                <div class="pop-col">
                  <h5>Faixa de Áudio</h5>
                  ${w.audio_tracks.map(a => `
                    <button class="pop-opt ${prog.audio === a ? 'selected' : ''}"
                            onclick="App.setAudioSub('${a}', null)">${a}</button>
                  `).join('')}
                </div>
                <div class="pop-col">
                  <h5>Legendas</h5>
                  ${w.subtitles.map(s => `
                    <button class="pop-opt ${prog.sub === s ? 'selected' : ''}"
                            onclick="App.setAudioSub(null, '${s}')">${s}</button>
                  `).join('')}
                </div>
              </div>
            ` : ''}
          </div>
        </div>
      </section>

      <!-- SELETOR HORIZONTAL FLUIDO DE SAGAS -->
      ${w.sagas.length > 1 ? `
        <div class="saga-strip">
          <button class="saga-pill ${this.activeSaga === 'all' ? 'active' : ''}"
                  onclick="App.activeSaga='all'; App.render()">
            <small>Visão Geral</small>
            <strong>Todas as Sagas (${w.sagas.length})</strong>
          </button>
          ${w.sagas.map(s => `
            <button class="saga-pill ${this.activeSaga === s.id ? 'active' : ''}"
                    onclick="App.activeSaga='${s.id}'; App.render()">
              <small>Saga ${s.number} • ${s.ep_range} • ${s.canon_ratio}% Canônico</small>
              <strong>${s.title}</strong>
            </button>
          `).join('')}
        </div>
      ` : ''}

      <!-- BARRA INTELIGENTE: FILTRO DE FILLER + ALTERNADOR DE DENSIDADE + BUSCA -->
      <div class="media-toolbar">
        <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
          <div class="filter-bar" style="margin:0;">
            <button class="seg-btn ${!this.onlyCanon ? 'active' : ''}"
                    onclick="App.onlyCanon=false; App.render()">Todos</button>
            <button class="seg-btn ${this.onlyCanon ? 'active' : ''}"
                    onclick="App.onlyCanon=true; App.render()">
              ✨ Apenas Canônicos ${hiddenFillers ? `(-${hiddenFillers} filler)` : ''}
            </button>
          </div>

          <div class="filter-bar" style="margin:0;">
            <button class="seg-btn ${!this.compactDensity ? 'active' : ''}"
                    onclick="App.compactDensity=false; App.render()">Lista Editorial</button>
            <button class="seg-btn ${this.compactDensity ? 'active' : ''}"
                    onclick="App.compactDensity=true; App.render()">Grade Compacta</button>
          </div>
        </div>

        <input type="text" class="inline-input" placeholder="Filtrar episódio por nº ou título..."
               value="${this.epQuery}" oninput="App.epQuery=this.value; App.render()" />
      </div>

      <!-- EPISÓDIOS: LISTA EDITORIAL OU GRADE COMPACTA -->
      ${!this.compactDensity ? `
        <div class="ep-list">
          ${filteredEps.map(ep => `
            <div class="ep-row ${prog.ep === ep.number ? 'playing' : ''}">
              <div class="ep-num-box">${ep.number}</div>
              <div>
                <div class="ep-tags">
                  <span class="${ep.is_canon ? 'tag-canon' : 'tag-filler'}">
                    ${ep.is_climax ? '★ Clímax de Arco' : (ep.is_canon ? '● Canônico' : '◌ Filler')}
                  </span>
                  <span style="color:var(--ink-tertiary);">• ${ep.duration_min} min • ${ep.air_year}</span>
                  ${!w.is_original_anime && ep.manga_chap_end ? `
                    <button class="tag-bridge"
                            onclick="App.openZenChapter(${ep.manga_chap_start || ep.manga_chap_end})"
                            title="Abrir capítulo equivalente no Leitor Zen">
                      ≈ Cap. ${ep.manga_chap_start === ep.manga_chap_end ? ep.manga_chap_end : `${ep.manga_chap_start}–${ep.manga_chap_end}`}
                    </button>
                  ` : ''}
                </div>
                <div class="ep-title">${ep.title}</div>
                <div class="ep-desc">${ep.summary}</div>
              </div>
              <div class="ep-actions">
                <button class="icon-btn" style="width:36px;height:36px;font-size:13px;"
                        title="Download MKV 1080p • Checksum SHA-256 Verificado (${ep.sha256_short})"
                        onclick="App.toast('Integridade SHA-256 verificada ✓ (' + '${ep.sha256_short}' + ')')">
                  ↓
                </button>
                <button class="btn ${prog.ep === ep.number ? 'btn-bridge' : 'btn-ghost'}" style="height:36px;padding:0 15px;font-size:13px;"
                        onclick="App.selectEpisode(${ep.number}, true)">
                  ${prog.ep === ep.number ? 'Reproduzindo' : '▶ Assistir'}
                </button>
              </div>
            </div>
          `).join('')}
        </div>
      ` : `
        <div class="ep-compact-grid">
          ${filteredEps.map(ep => `
            <button class="ep-tile ${prog.ep === ep.number ? 'playing' : ''}"
                    onclick="App.selectEpisode(${ep.number}, true)">
              <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--ink-secondary);margin-bottom:4px;">
                <strong>Ep. ${ep.number}</strong>
                <span>${ep.is_canon ? 'Canônico' : 'Filler'}</span>
              </div>
              <div style="font-size:13px;font-weight:600;color:var(--ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                ${ep.title}
              </div>
            </button>
          `).join('')}
        </div>
      `}
    `;
  },

  renderMangaMode(w) {
    return `
      <div class="section-head">
        <div>
          <h2 class="section-title">Capítulos Oficiais Mapeados</h2>
          <p class="section-sub">Sem cards duplicados: clique em qualquer capítulo para abrir o Leitor Zen integrado.</p>
        </div>
      </div>

      <div class="ep-list">
        ${w.chapters.map(ch => `
          <div class="ep-row">
            <div class="ep-num-box">#${ch.number}</div>
            <div>
              <div class="ep-tags">
                <span class="tag-canon">Edição Oficial PT-BR</span>
                <span style="color:var(--ink-tertiary);">• ${ch.arc_name} • ${ch.pages} págs • ${ch.release_year}</span>
                ${ch.anime_ep_equiv ? `
                  <button class="tag-bridge" onclick="App.workTab='anime'; App.selectEpisode(${ch.anime_ep_equiv}, true)">
                    ⇄ Equivale ao Ep. ${ch.anime_ep_equiv}
                  </button>
                ` : `<span class="tag-bridge" style="cursor:default;">✦ Arco Posterior / Direto no Mangá</span>`}
              </div>
              <div class="ep-title">Capítulo ${ch.number} — ${ch.title}</div>
            </div>
            <div class="ep-actions">
              <button class="btn btn-primary" style="height:36px;padding:0 16px;font-size:13px;"
                      onclick="App.openZenChapter(${ch.number})">
                Ler Capítulo →
              </button>
            </div>
          </div>
        `).join('')}
      </div>
    `;
  },

  // ==========================================================================
  // INTERAÇÕES DINÂMICAS COM O BACKEND PYTHON
  // ==========================================================================
  async selectEpisode(epNumber, notify = true) {
    const w = this.currentWork;
    if (!w) return;
    w.user_progress.ep = epNumber;

    await fetch('/api/state', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'save_progress', slug: w.slug, ep: epNumber })
    });

    const cbRes = await fetch(`/api/bridge?slug=${w.slug}&mode=anime&num=${epNumber}`);
    w.canon_bridge = await cbRes.json();

    if (notify) this.toast(`Episódio ${epNumber} sincronizado com CanonBridge™`);
    this.render();
  },

  async setAudioSub(audio, sub) {
    const w = this.currentWork;
    if (audio) w.user_progress.audio = audio;
    if (sub) w.user_progress.sub = sub;
    this.showAudioPop = false;
    await fetch('/api/state', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'save_progress',
        slug: w.slug,
        audio: w.user_progress.audio,
        sub: w.user_progress.sub
      })
    });
    this.toast(`Preferência atualizada: ${w.user_progress.audio}`);
    this.render();
  },

  async jumpViaCanonBridge() {
    const w = this.currentWork;
    if (!w || !w.canon_bridge) return;
    const targetChap = w.canon_bridge.target_chap || (w.chapters[0] && w.chapters[0].number);
    if (targetChap) {
      this.workTab = 'manga';
      this.render();
      this.openZenChapter(targetChap);
    }
  },

  openZenChapter(chapNumber) {
    const w = this.currentWork;
    if (!w || !w.chapters.length) return;
    const ch = w.chapters.find(c => c.number === chapNumber) || w.chapters[0];
    const modal = document.getElementById('zenContent');

    modal.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
        <div>
          <div style="font-size:11.5px;font-weight:600;color:var(--ink-secondary);text-transform:uppercase;letter-spacing:0.06em;">
            Leitor Zen • ${w.title}
          </div>
          <h3 style="font-size:22px;font-weight:700;letter-spacing:-0.02em;">Capítulo ${ch.number}: ${ch.title}</h3>
        </div>
        <div style="display:flex;gap:8px;">
          ${ch.anime_ep_equiv ? `
            <button class="btn btn-bridge" style="height:36px;padding:0 14px;font-size:12.5px;"
                    onclick="App.closeZen(); App.workTab='anime'; App.selectEpisode(${ch.anime_ep_equiv}, true)">
              ⇄ Ir ao Episódio ${ch.anime_ep_equiv} no Anime
            </button>
          ` : ''}
          <button class="icon-btn" style="width:36px;height:36px;" onclick="App.closeZen()">✕</button>
        </div>
      </div>

      <div class="zen-page">
        ${ch.preview_lines.map(p => `<p style="margin-bottom:16px;">${p}</p>`).join('')}
        <p style="font-size:12.5px;color:var(--ink-tertiary);margin-top:24px;border-top:1px solid var(--hairline);padding-top:14px;">
          Sincronizado via Wotho CanonBridge™ • ${ch.pages} páginas oficiais mapeadas (${ch.arc_name}).
        </p>
      </div>
    `;
    document.getElementById('zenOverlay').classList.add('open');
  },

  closeZen() {
    document.getElementById('zenOverlay').classList.remove('open');
  },

  async toggleWatchlist(slug) {
    const res = await fetch('/api/state', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'toggle_watchlist', slug })
    });
    this.boot.user_state = await res.json();
    const added = this.boot.user_state.watchlist.includes(slug);
    this.toast(added ? 'Adicionado à Minha Lista' : 'Removido da Minha Lista');
    this.render();
  },

  async toggleReminder(slug) {
    const res = await fetch('/api/state', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'toggle_reminder', slug })
    });
    this.boot.user_state = await res.json();
    const active = this.boot.user_state.reminders.includes(slug);
    this.toast(active ? '🔔 Lembrete semanal ativado' : 'Lembrete desativado');
    this.render();
  },

  // ==========================================================================
  // COMMAND SPOTLIGHT (⌘K)
  // ==========================================================================
  openSpotlight() {
    document.getElementById('spotlightOverlay').classList.add('open');
    const inp = document.getElementById('spotlightInput');
    inp.value = '';
    inp.focus();
    this.onSpotlightInput('ep ');
  },

  closeSpotlight() {
    document.getElementById('spotlightOverlay').classList.remove('open');
  },

  async onSpotlightInput(val) {
    const q = val.trim() || 'a';
    const res = await fetch(`/api/spotlight?q=${encodeURIComponent(q)}`);
    const items = await res.json();
    const box = document.getElementById('spotlightResults');

    if (!items.length) {
      box.innerHTML = `<div style="padding:18px;color:var(--ink-secondary);font-size:13.5px;">Nenhum resultado para "${val}".</div>`;
      return;
    }

    box.innerHTML = items.map(it => {
      let action = `App.closeSpotlight(); App.openWork('${it.slug}', 'anime')`;
      if (it.type === 'episode') action = `App.closeSpotlight(); App.openWork('${it.slug}', 'anime', ${it.ep})`;
      if (it.type === 'chapter') action = `App.closeSpotlight(); App.openWork('${it.slug}', 'manga', ${it.chap})`;
      return `
        <div class="spot-item" onclick="${action}">
          <div>
            <div style="font-size:14px;font-weight:600;color:var(--ink);">${it.title}</div>
            <div style="font-size:12px;color:var(--ink-secondary);">${it.subtitle}</div>
          </div>
          <span class="genre-pill">${it.badge}</span>
        </div>
      `;
    }).join('');
  }
};

window.addEventListener('DOMContentLoaded', () => App.init());
</script>
</body>
</html>
"""


# ==============================================================================
# 5. CAMADA DE SERVIDOR DUAL (FASTAPI ASGI + FALLBACK NATIVO ZERO-DEPENDÊNCIA)
# ==============================================================================

ENGINE = WothoCoreEngine()


def find_free_port(preferred: int = 8000) -> int:
    for port in (preferred, 8080, 8088, 5000):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            if s.connect_ex(("127.0.0.1", port)) != 0:
                return port
    return preferred


def create_fastapi_app():
    """Cria instância FastAPI profissional (se instalada no ambiente)."""
    from fastapi import FastAPI, HTTPException, Request
    from fastapi.responses import HTMLResponse, JSONResponse, Response

    app = FastAPI(title="Wotho Next-Gen UI & CanonBridge API", version="2.0.0")

    @app.get("/", response_class=HTMLResponse)
    async def index():
        return FRONTEND_HTML

    @app.get("/api/bootstrap")
    async def api_bootstrap():
        return JSONResponse(ENGINE.get_bootstrap_payload())

    @app.get("/api/work/{slug}")
    async def api_work(slug: str):
        data = ENGINE.get_work_detail(slug)
        if not data:
            raise HTTPException(status_code=404, detail="Obra não encontrada")
        return JSONResponse(data)

    @app.get("/api/bridge")
    async def api_bridge(slug: str, mode: str = "anime", num: int = 1):
        return JSONResponse(ENGINE.resolve_canon_bridge(slug, mode, num))

    @app.get("/api/spotlight")
    async def api_spotlight(q: str = ""):
        return JSONResponse(ENGINE.spotlight_search(q))

    @app.post("/api/state")
    async def api_state(req: Request):
        body = await req.json()
        return JSONResponse(ENGINE.update_state(body.get("action", ""), body))

    @app.get("/api/art/{slug}")
    async def api_art(slug: str):
        work = ENGINE.works.get(slug)
        if not work:
            raise HTTPException(status_code=404, detail="Arte não encontrada")
        svg = render_criterion_poster_svg(work)
        return Response(content=svg, media_type="image/svg+xml")

    return app


class NativeFallbackHandler(BaseHTTPRequestHandler):
    """Servidor multithread padrão do Python caso FastAPI/Uvicorn não estejam instalados."""

    def log_message(self, format: str, *args: Any) -> None:
        return  # Mantém o terminal limpo e elegante

    def _send(self, body: bytes, content_type: str, status: int = 200) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        self.wfile.write(body)

    def _send_json(self, data: Any, status: int = 200) -> None:
        self._send(json.dumps(data, ensure_ascii=False).encode("utf-8"), "application/json; charset=utf-8", status)

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        path = parsed.path
        qs = parse_qs(parsed.query)

        if path == "/":
            self._send(FRONTEND_HTML.encode("utf-8"), "text/html; charset=utf-8")
        elif path == "/api/bootstrap":
            self._send_json(ENGINE.get_bootstrap_payload())
        elif path.startswith("/api/work/"):
            slug = path.split("/api/work/", 1)[1]
            data = ENGINE.get_work_detail(slug)
            self._send_json(data if data else {"error": "Not found"}, 200 if data else 404)
        elif path == "/api/bridge":
            slug = qs.get("slug", [""])[0]
            mode = qs.get("mode", ["anime"])[0]
            num = int(qs.get("num", ["1"])[0])
            self._send_json(ENGINE.resolve_canon_bridge(slug, mode, num))
        elif path == "/api/spotlight":
            q = qs.get("q", [""])[0]
            self._send_json(ENGINE.spotlight_search(q))
        elif path.startswith("/api/art/"):
            slug = path.split("/api/art/", 1)[1]
            work = ENGINE.works.get(slug)
            if not work:
                self._send(b"Not found", "text/plain", 404)
                return
            svg = render_criterion_poster_svg(work).encode("utf-8")
            self._send(svg, "image/svg+xml; charset=utf-8")
        else:
            self._send(b"Not found", "text/plain", 404)

    def do_POST(self) -> None:
        if self.path == "/api/state":
            length = int(self.headers.get("Content-Length", "0"))
            raw = self.rfile.read(length).decode("utf-8") if length else "{}"
            body = json.loads(raw)
            updated = ENGINE.update_state(body.get("action", ""), body)
            self._send_json(updated)
        else:
            self._send_json({"error": "Not found"}, 404)


def main() -> None:
    port = find_free_port(8000)
    url = f"http://127.0.0.1:{port}"

    print("\n" + "=" * 68)
    print("  WOTHO NEXT-GEN • Arquitetura Bimodal & Design System Apple HIG")
    print("=" * 68)
    print(f"  ➜ Interface Ao Vivo : {url}")
    print("  ➜ Atalho Spotlight  : Pressione Cmd+K (ou Ctrl+K / '/') no navegador")
    print("  ➜ Fluxo Recomendado : Abra 'One Piece' para testar o CanonBridge™")
    print("=" * 68 + "\n")

    threading.Timer(0.9, lambda: webbrowser.open(url)).start()

    try:
        import uvicorn
        app = create_fastapi_app()
        print(f"  [Engine] Rodando via FastAPI + Uvicorn ASGI (Swagger em {url}/docs)\n")
        uvicorn.run(app, host="127.0.0.1", port=port, log_level="warning")
    except ImportError:
        print("  [Engine] Rodando via Servidor Multithread Nativo do Python (Zero-Dependency)\n")
        server = ThreadingHTTPServer(("127.0.0.1", port), NativeFallbackHandler)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            print("\n  Encerrando servidor Wotho...")
            server.server_close()


if __name__ == "__main__":
    main()
