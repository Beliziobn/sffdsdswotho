    def get_bootstrap_payload(self) -> Dict[str, Any]:
        all_works = list(self.works.values())
        ranked = sorted(
            [w for w in all_works if w.rank_position is not None],
            key=lambda x: x.rank_position or 99
        )
        philosophical = [w for w in all_works if w.philosophical_quote is not None]

        # Organiza calendário semanal limpo
        days = ["Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado", "Domingo"]
        schedule: Dict[str, List[Dict[str, Any]]] = {d: [] for d in days}
        for w in all_works:
            if w.simulcast_day in schedule:
                schedule[w.simulcast_day].append({
                    "slug": w.slug,
                    "title": w.title,
                    "studio": w.studio,
                    "time": w.simulcast_time or "14:00",
                    "episodes": w.total_episodes,
                    "rating": w.rating,
                })
        for day, label, slug, time_str in self.simulcast_extras:
            if slug in self.works:
                ref = self.works[slug]
                schedule[day].append({
                    "slug": ref.slug,
                    "title": label,
                    "studio": ref.studio,
                    "time": time_str,
                    "episodes": ref.total_episodes,
                    "rating": ref.rating,
                })

        return {
            "featured_slugs": ["frieren", "one-piece", "orb-movimentos-da-terra"],
            "catalog": [self._serialize_card(w) for w in all_works],
            "philosophical": [self._serialize_card(w, include_quote=True) for w in philosophical],
            "ranking": [self._serialize_card(w) for w in ranked],
            "schedule": schedule,
            "user_state": self.user_state,
        }

    def _serialize_card(self, w: MediaWork, include_quote: bool = False) -> Dict[str, Any]:
        prog = self.user_state["progress"].get(w.slug)
        data = {
            "slug": w.slug,
            "title": w.title,
            "jp_title": w.jp_title,
            "studio": w.studio,
            "year": w.year,
            "rating": w.rating,
            "status": w.status,
            "is_original_anime": w.is_original_anime,
            "genres": w.genres[:2],
            "categories": w.categories,
            "logline": w.logline,
            "accent_hex": w.accent_hex,
            "ambient_rgb": w.ambient_rgb,
            "total_episodes": w.total_episodes,
            "total_chapters": w.total_chapters,
            "rank_position": w.rank_position,
            "poster_url": w.poster_url or f"/api/art/{w.slug}",
            "progress": prog,
        }
        if include_quote:
            data["philosophical_quote"] = w.philosophical_quote
        return data

    def get_work_detail(self, slug: str) -> Optional[Dict[str, Any]]:
        w = self.works.get(slug)
        if not w:
            return None
        payload = asdict(w)
        payload["poster_url"] = w.poster_url or f"/api/art/{w.slug}"
        payload["user_progress"] = self.user_state["progress"].get(
            slug,
            {
                "ep": w.episodes[0].number if w.episodes else 1,
                "chap": w.chapters[0].number if w.chapters else 1,
                "audio": w.audio_tracks[0] if w.audio_tracks else "Japonês (Original)",
                "sub": w.subtitles[0] if w.subtitles else "Português (PT-BR)",
            },
        )
        payload["canon_bridge"] = self.resolve_canon_bridge(
            slug, "anime", payload["user_progress"]["ep"]
        )
        return payload

    def resolve_canon_bridge(self, slug: str, mode: str, number: int) -> Dict[str, Any]:
        """Calcula em tempo real o ponto exato de transição entre Anime e Mangá."""
        w = self.works.get(slug)
        if not w or w.is_original_anime:
            return {
                "supported": False,
                "label": "Obra Original para TV — Roteiro concebido diretamente para animação.",
            }

        if mode == "anime":
            ep = next((e for e in w.episodes if e.number == number), None)
            if ep and not ep.is_canon:
                return {
                    "supported": True,
                    "is_filler": True,
                    "label": f"Episódio {number} é exclusivo do anime (Filler). Retome a história canônica no Mangá.",
                    "target_chap": w.chapters[0].number if w.chapters else 1,
                    "cta": f"Ir ao Mangá Canônico",
                }
            if ep and ep.manga_chap_end:
                # Sugere o próximo capítulo disponível no acervo ou o capítulo equivalente
                next_chap = ep.manga_chap_end + 1
                available = next((c.number for c in w.chapters if c.number >= next_chap), ep.manga_chap_end)
                span = (
                    f"Cap. {ep.manga_chap_start}"
                    if ep.manga_chap_start == ep.manga_chap_end
                    else f"Caps. {ep.manga_chap_start}–{ep.manga_chap_end}"
                )
                return {
                    "supported": True,
                    "is_filler": False,
                    "equiv_span": span,
                    "target_chap": available,
                    "label": f"Ep. {ep.number} adapta {span} do Mangá",
                    "cta": f"Continuar no Cap. {available}",
                }

        elif mode == "manga":
            chap = next((c for c in w.chapters if c.number == number), None)
            if chap and chap.anime_ep_equiv:
                return {
                    "supported": True,
                    "target_ep": chap.anime_ep_equiv,
                    "label": f"Cap. {chap.number} corresponde ao Episódio {chap.anime_ep_equiv} do Anime",
                    "cta": f"Assistir Ep. {chap.anime_ep_equiv}",
                }
            return {
                "supported": True,
                "target_ep": w.episodes[-1].number if w.episodes else 1,
                "label": f"Cap. {number} avança em arco inédito ou posterior aos episódios mapeados",
                "cta": "Ver Último Episódio Adaptado",
            }

        return {
            "supported": True,
            "target_chap": w.chapters[0].number if w.chapters else 1,
            "label": "Sincronização CanonBridge™ ativa",
            "cta": "Alternar para Mangá",
        }

    def spotlight_search(self, query: str) -> List[Dict[str, Any]]:
        q = query.strip().lower()
        if not q:
            return []
        results: List[Dict[str, Any]] = []

        # 1. Busca de obras, estúdios, autores e gêneros
        for w in self.works.values():
            haystack = f"{w.title} {w.jp_title} {w.studio} {w.author} {' '.join(w.genres)} {' '.join(w.categories)}".lower()
            if q in haystack:
                results.append({
                    "type": "work",
                    "slug": w.slug,
                    "title": w.title,
                    "subtitle": f"{w.studio} • ★ {w.rating} • {'Obra Original' if w.is_original_anime else f'{w.total_episodes} eps / {w.total_chapters} caps'}",
                    "badge": "Obra",
                })

            # 2. Busca profunda de Episódios e Arcos (ex: "ep 4", "gear 5", "egghead", "shanks")
            for ep in w.episodes:
                ep_str = f"ep {ep.number} episodio {ep.number} {ep.title} {ep.saga_id}".lower()
                if q in ep_str:
                    results.append({
                        "type": "episode",
                        "slug": w.slug,
                        "ep": ep.number,
                        "title": f"{w.title.split(':')[0]} — Ep. {ep.number}: {ep.title}",
                        "subtitle": f"{'Canônico' if ep.is_canon else 'Filler'} • {ep.duration_min} min",
                        "badge": "Episódio",
                    })

            # 3. Busca profunda de Capítulos (ex: "cap 8", "romance dawn")
            for ch in w.chapters:
                ch_str = f"cap {ch.number} capitulo {ch.number} {ch.title} {ch.arc_name}".lower()
                if q in ch_str:
                    results.append({
                        "type": "chapter",
                        "slug": w.slug,
                        "chap": ch.number,
                        "title": f"{w.title.split(':')[0]} — Cap. {ch.number}: {ch.title}",
                        "subtitle": f"{ch.arc_name} • {ch.pages} páginas",
                        "badge": "Mangá",
                    })

        return results[:10]

    def update_state(self, action: str, payload: Dict[str, Any]) -> Dict[str, Any]:
        slug = payload.get("slug", "")
        if action == "toggle_watchlist" and slug:
            wl = self.user_state["watchlist"]
            if slug in wl:
                wl.remove(slug)
            else:
                wl.append(slug)
        elif action == "toggle_reminder" and slug:
            rm = self.user_state["reminders"]
            if slug in rm:
                rm.remove(slug)
            else:
                rm.append(slug)
        elif action == "save_progress" and slug:
            curr = self.user_state["progress"].setdefault(slug, {})
            for k in ("ep", "chap", "audio", "sub"):
                if k in payload and payload[k] is not None:
                    curr[k] = payload[k]
        return self.user_state


