          </div>

          <p class="work-synopsis">${w.synopsis}</p>

          <!-- CLUSTER ÚNICO DE DECISÃO -->
          <div class="action-cluster">
            <button class="btn btn-primary" onclick="App.workTab='anime'; App.render(); document.getElementById('mediaStage')?.scrollIntoView({behavior:'smooth'})">
              ▶ Assistir T1: Ep. ${prog.ep}
            </button>

            ${!w.is_original_anime && cb && cb.supported ? `
