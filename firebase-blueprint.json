{
  "entities": {
    "news": {
      "title": "News Item",
      "description": "Journalistic article or news piece published on Worscoi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "slug": { "type": "string", "maxLength": 150 },
        "excerpt": { "type": "string", "maxLength": 2000 },
        "content": { "type": "string", "maxLength": 50000 },
        "cover_url": { "type": "string", "maxLength": 500000 },
        "category": { "type": "string", "maxLength": 100 },
        "published": { "type": "boolean" },
        "published_at": { "type": "string", "maxLength": 100 },
        "created_at": { "type": "string", "maxLength": 100 },
        "updated_at": { "type": "string", "maxLength": 100 },
        "author": { "type": "string", "maxLength": 150 },
        "source_name": { "type": "string", "maxLength": 150 },
        "source_url": { "type": "string", "maxLength": 1000 }
      },
      "required": ["title", "slug", "content", "published"]
    },
    "books": {
      "title": "Book Publication",
      "description": "Book or literary work published or customized by editorial admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "author": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 10000 },
        "cover_url": { "type": "string", "maxLength": 1000 },
        "price_cents": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "category": { "type": "string", "maxLength": 100 },
        "published": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "created_at": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "author", "published"]
    },
    "chapters": {
      "title": "Book Chapter",
      "description": "Chapter belonging to a book publication",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "book_id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "maxLength": 100000 },
        "position": { "type": "number" },
        "is_free_preview": { "type": "boolean" }
      },
      "required": ["book_id", "title", "content", "position"]
    },
    "anime_overrides": {
      "title": "Anime Override",
      "description": "Editorial customizations for anime titles in the catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "synopsis": { "type": "string", "maxLength": 5000 },
        "cover": { "type": "string", "maxLength": 1000 },
        "banner": { "type": "string", "maxLength": 1000 },
        "trailerYoutubeId": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id"]
    },
    "user_profiles": {
      "title": "User Profile",
      "description": "Personal profile preferences, bio, and display name for a Wotho user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 600 },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "preferredLanguage": { "type": "string", "maxLength": 20 },
        "preferredReaderTheme": { "type": "string", "maxLength": 20 },
        "favoriteGenres": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["userId", "displayName"]
    },
    "user_history": {
      "title": "User Activity History Entry",
      "description": "Reading and watching history entry for books, cinema, animes, webtoons, and news",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "itemId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 30 },
        "title": { "type": "string", "maxLength": 300 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "cover": { "type": "string", "maxLength": 1000 },
        "href": { "type": "string", "maxLength": 500 },
        "progressPercent": { "type": "number" },
        "detailLabel": { "type": "string", "maxLength": 200 },
        "timestamp": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "userId", "itemId", "type", "title", "href", "timestamp"]
    },
    "test_connection": {
      "title": "Test Connection",
      "description": "Used by app startup to verify Firestore connectivity",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 50 }
      }
    }
  },
  "firestore": {
    "/news/{newsId}": {
      "schema": "news",
      "description": "Collection of all published and editorial news articles"
    },
    "/books/{bookId}": {
      "schema": "books",
      "description": "Collection of all editorial books published on Worscoi"
    },
    "/chapters/{chapterId}": {
      "schema": "chapters",
      "description": "Collection of all editorial chapters for books"
    },
    "/anime_overrides/{animeId}": {
      "schema": "anime_overrides",
      "description": "Collection of editorial overrides for anime entries"
    },
    "/user_profiles/{userId}": {
      "schema": "user_profiles",
      "description": "User profile document owned by userId"
    },
    "/user_profiles/{userId}/history/{entryId}": {
      "schema": "user_history",
      "description": "User activity history items owned by userId"
    },
    "/test/{testId}": {
      "schema": "test_connection",
      "description": "Collection used for connectivity verification"
    }
  }
}
